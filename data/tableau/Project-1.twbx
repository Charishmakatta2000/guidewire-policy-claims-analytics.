      <column caption='Total Premium' datatype='real' name='[Calculation_3137972723605512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([written_premium])' />
      </column>
      <column caption='Total Loss' datatype='real' name='[Calculation_3137972723691529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [transaction_type] = &apos;Loss Payment&apos; THEN [amount] ELSE 0 END)' />
      </column>
      <column caption='Loss ratio' datatype='real' name='[Calculation_3137972723793930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3137972723691529] / [Calculation_3137972723605512]' />
      </column>
      <column caption='Claim Cycle Time' datatype='integer' name='[Calculation_3137975197483019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [reported_date (cc_claim.csv1)], [close_date (cc_claim.csv1)])' />
      </column>
      <column caption='Average Severity' datatype='real' name='[Calculation_3137975197663244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [transaction_type] = &apos;Loss Payment&apos; THEN [amount] ELSE 0 END) / COUNTD([claim_id])' />
      </column>
